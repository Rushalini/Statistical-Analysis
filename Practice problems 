        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "ord_time =[11,10,4,12,8]\n",
        "del_time=[12.30,11.00,4.15,5.20,8.45]\n",
        "del_partner=[2,5,4,3,7]\n",
        "cus_ratings=[4,2,3,5,4]\n",
        "print(\"-------Zomato Dataset-------\")\n",
        "df=pd.DataFrame({\"Order Time\":ord_time,\"Delivery Time\":del_time,\"Delivery Partner\":del_partner,\"Customer Ratings\":cus_ratings})\n",
        "print(df)\n",
        "Avg_del_time=np.mean(del_time)\n",
        "print(\"Average Delivery Time: \",Avg_del_time)\n",
        "Peak_hours=ord_time.index(max(ord_time))\n",
        "print(\"Peak Order Hours: \",Peak_hours)\n",
        "Most_delayed_partner=del_partner.index(max(del_partner))\n",
        "print(\"Most Delayed Partner: \",Most_delayed_partner)\n",
        "Top_rated_delivery_Partner=cus_ratings.index(max(cus_ratings))\n",
        "print(\"Top Rated Delivery Partner: \",Top_rated_delivery_Partner)\n",
        "plt.bar(ord_time,del_time)\n",
        "plt.xlabel(\"Order Time\")\n",
        "plt.ylabel(\"Delivery Time\")\n",
        "plt.title(\"Order Time vs Delivery Time\")\n",
        "plt.show()\n",
        "print(\"\\n\")\n",
        "plt.pie(cus_ratings,labels=del_partner,autopct='%1.1f%%')\n",
        "plt.title(\"Delivery Partner Ratings\")\n",
        "plt.show()\n",
        "print(\"\\n\")\n",
        "plt.scatter(del_partner,cus_ratings)\n",
        "plt.xlabel(\"Delivery Partner\")\n",
        "plt.ylabel(\"Customer Ratings\")\n",
        "plt.title(\"Delivery Partner vs Customer Ratings\")\n",
        "plt.show()\n",
        "print(\"\\n\")\n"
      ]
