        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "data={\n",
        "    \"product_purchase\":[\"laptop\",\"mouse\",\"wires\",\"laptop\",\"ear buds\"],\n",
        "    \"cart_abondonment\":[2,3,4,1,5],\n",
        "    \"cus_ratings\":[4.5,2.7,3,5,4],\n",
        "    \"Pay_method\":[\"cash\",\"cash\",\"credit\",\"cash\",\"UPI\"]\n",
        "    }\n",
        "df=pd.DataFrame(data)\n",
        "print(df)\n",
        "most_sold=df['product_purchase'].mode()[0]\n",
        "print(f\"Most Sold Product: {most_sold}\")\n",
        "High_revenue_prod=df.loc[df['cart_abondonment'].idxmax(),'product_purchase']\n",
        "print(f\"Product with Highest Revenue: {High_revenue_prod}\")\n",
        "Most_pay_methods=df['Pay_method'].mode()[0]\n",
        "print(f\"Most Used Payment Method: {Most_pay_methods}\")\n",
        "poor_rating_prod=df.loc[df['cus_ratings'].idxmin(),'product_purchase']\n",
        "print(f\"Product with Poor Ratings: {poor_rating_prod}\")"
